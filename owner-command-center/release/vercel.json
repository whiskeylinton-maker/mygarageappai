{
 "buildCommand": "sh scripts/build-chain.sh",
 "outputDirectory": "public",
 "installCommand": "npm install --no-audit --no-fund",
 "headers": [
  {
   "source": "/watchtower.html",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    },
    {
     "key": "Cache-Control",
     "value": "no-store"
    },
    {
     "key": "X-Frame-Options",
     "value": "DENY"
    },
    {
     "key": "Referrer-Policy",
     "value": "no-referrer"
    }
   ]
  }
 ]
}
